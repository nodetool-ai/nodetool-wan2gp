# syntax=docker/dockerfile:1.7
# Free, non-monetized evaluation image. See NOTICE.md and
# docs/combined-image-licenses.md before building or redistributing it.
#
# It runs WanGP's own MCP server behind a bearer-token proxy. NodeTool's
# built-in lib.wan2gp nodes and wangp provider connect to it over HTTP with
# WAN2GP_MCP_URL and WAN2GP_MCP_TOKEN. No NodeTool code runs in this image.
#
# The base, Python and PyTorch follow WanGP's own Dockerfile at the pinned
# revision: CUDA 12.8 on Ubuntu 22.04, whose Python 3.10 makes WanGP's
# requirements pick the stable onnxruntime-gpu 1.22.0.
ARG CUDA_IMAGE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04
FROM ${CUDA_IMAGE}

ARG WANGP_REPOSITORY=https://github.com/deepbeepmeep/Wan2GP.git
# WanGP v19.02, MCP API v2.1.
ARG WANGP_COMMIT=616e60506aff10086bbbde02a3bf4554c572adde

LABEL org.opencontainers.image.title="WanGP MCP server for NodeTool (non-commercial)" \
      org.opencontainers.image.description="WanGP's MCP server behind a bearer-token proxy; free non-monetized evaluation only" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later AND LicenseRef-WanGP-Community-2.0" \
      org.opencontainers.image.source="https://github.com/nodetool-ai/nodetool-wan2gp" \
      io.nodetool.wangp.commit="616e60506aff10086bbbde02a3bf4554c572adde" \
      io.nodetool.commercial-use="prohibited-without-separate-written-license"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates ffmpeg git libgl1 libglib2.0-0 libportaudio2 \
        libsndfile1 python3 python3-dev python3-venv build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv --copies /opt/wan2gp-venv \
    && /opt/wan2gp-venv/bin/python -m pip install --upgrade pip setuptools wheel \
    && /opt/wan2gp-venv/bin/python -m pip install \
        torch==2.10.0 torchvision==0.25.0 torchaudio==2.10.0 \
        --index-url https://download.pytorch.org/whl/cu128

# WanGP vendors mmgp in its mmgp/ folder, under the WanGP Community License
# 2.0. Its LICENSE.txt, mmgp/LICENSE.md and docs/third_party_licenses stay in
# this checkout.
RUN git clone --filter=blob:none "${WANGP_REPOSITORY}" /opt/Wan2GP \
    && git -C /opt/Wan2GP fetch --depth 1 origin "${WANGP_COMMIT}" \
    && git -C /opt/Wan2GP checkout --detach "${WANGP_COMMIT}" \
    && /opt/wan2gp-venv/bin/python -m pip install -r /opt/Wan2GP/requirements.txt \
    && rm -rf /root/.cache/pip

COPY NOTICE.md docs/combined-image-licenses.md docs/combined-worker.md /opt/licenses/nodetool-wan2gp/
COPY scripts/combined-entrypoint.sh /usr/local/bin/nodetool-wangp-entrypoint
COPY scripts/combined-healthcheck.py /usr/local/bin/nodetool-wangp-healthcheck
COPY combined/auth_proxy.py /opt/nodetool-wan2gp-combined/auth_proxy.py
RUN chmod 0755 /usr/local/bin/nodetool-wangp-entrypoint /usr/local/bin/nodetool-wangp-healthcheck \
    && mkdir -p /workspace/wan2gp/config /workspace/wan2gp/models \
        /workspace/wan2gp/outputs /workspace/cache \
    && rm -rf /opt/Wan2GP/ckpts /opt/Wan2GP/outputs \
    && ln -s /workspace/wan2gp/models /opt/Wan2GP/ckpts \
    && ln -s /workspace/wan2gp/outputs /opt/Wan2GP/outputs

ENV WANGP_CONFIG_DIR=/workspace/wan2gp/config \
    WANGP_MODEL_DIR=/workspace/wan2gp/models \
    WANGP_OUTPUT_DIR=/workspace/wan2gp/outputs \
    WANGP_ROOT=/opt/Wan2GP \
    WAN2GP_MCP_PORT=7866 \
    WANGP_UPSTREAM_PORT=7867 \
    HF_HOME=/workspace/cache/huggingface \
    PYTHONUNBUFFERED=1 \
    SDL_AUDIODRIVER=dummy \
    PULSE_RUNTIME_PATH=/tmp/pulse-runtime

EXPOSE 7866
HEALTHCHECK --interval=15s --timeout=5s --start-period=300s --retries=8 \
    CMD ["/opt/wan2gp-venv/bin/python", "/usr/local/bin/nodetool-wangp-healthcheck"]

ENTRYPOINT ["/usr/local/bin/nodetool-wangp-entrypoint"]
